package main

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"log"
	"os"
	"os/signal"
	"strconv"
	"syscall"
	"time"

	amqp "github.com/rabbitmq/amqp091-go"
)

const (
	rabbitURL  = "amqp://guest:guest@localhost:5672/" // ajuste via env se precisar
	queueName  = "worker"
	maxRetries = 3
)

// Exemplo de estrutura esperada (ajuste conforme sua mensagem)
type Payload struct {
	ID      string `json:"id,omitempty"`
	Message string `json:"message"`
	// adicione outros campos se precisar
}

func main() {
	log.SetFlags(log.LstdFlags | log.Lshortfile)

	// Context para cancelar goroutines ao receber sinal
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()

	// Captura Ctrl+C / SIGTERM
	sigs := make(chan os.Signal, 1)
	signal.Notify(sigs, syscall.SIGINT, syscall.SIGTERM)

	// Conecta ao RabbitMQ (com retry)
	conn, err := connectWithRetry(10*time.Second, 6) // tenta 6 vezes a cada 10s
	if err != nil {
		log.Fatalf("Não foi possível conectar ao RabbitMQ: %v", err)
	}
	defer conn.Close()
	log.Println("Conectado ao RabbitMQ")

	// Abre canal
	ch, err := conn.Channel()
	if err != nil {
		log.Fatalf("Erro ao abrir canal: %v", err)
	}
	defer ch.Close()

	// Garante que a fila existe
	_, err = ch.QueueDeclare(
		queueName,
		true,  // durable
		false, // delete quando unused
		false, // exclusive
		false, // no-wait
		nil,   // args
	)
	if err != nil {
		log.Fatalf("Erro ao declarar fila: %v", err)
	}

	// Prefetch para 1 mensagem por consumer (trabalho por vez)
	if err := ch.Qos(1, 0, false); err != nil {
		log.Fatalf("Erro ao setar QoS: %v", err)
	}

	msgs, err := ch.Consume(
		queueName,
		"",    // consumer
		false, // autoAck -> false para manual ack
		false, // exclusive
		false, // noLocal
		false, // noWait
		nil,   // args
	)
	if err != nil {
		log.Fatalf("Erro ao iniciar consumo: %v", err)
	}

	// Goroutine que roda o loop de consumo
	go func() {
		for d := range msgs {
			handleDelivery(ch, &d)
		}
		log.Println("Canal de mensagens fechado")
		cancel()
	}()

	// Espera sinal de término
	select {
	case <-sigs:
		log.Println("Sinal recebido, encerrando...")
		// fecha o canal e a conexão ordenadamente
		_ = ch.Cancel("", false)
		// aguarda contexto ser cancelado
		<-ctx.Done()
	case <-ctx.Done():
	}

	log.Println("Worker encerrado")
}

// connectWithRetry tenta conectar várias vezes ao RabbitMQ
func connectWithRetry(interval time.Duration, attempts int) (*amqp.Connection, error) {
	var conn *amqp.Connection
	var err error
	for i := 0; i < attempts; i++ {
		conn, err = amqp.Dial(getRabbitURL())
		if err == nil {
			return conn, nil
		}
		log.Printf("Tentativa %d/%d: RabbitMQ não disponível (%v). tentando de novo em %s...", i+1, attempts, err, interval)
		time.Sleep(interval)
	}
	return nil, fmt.Errorf("não conseguiu conectar após %d tentativas: %w", attempts, err)
}

func getRabbitURL() string {
	if u := os.Getenv("RABBIT_URL"); u != "" {
		return u
	}
	return rabbitURL
}

// handleDelivery processa uma mensagem recebida
func handleDelivery(ch *amqp.Channel, d *amqp.Delivery) {
	log.Printf("Recebida mensagem: %s", string(d.Body))

	// Exemplo de validação: tentar decodificar JSON (se não for JSON, tratamos como texto)
	var p Payload
	if err := json.Unmarshal(d.Body, &p); err != nil {
		// Se não for JSON válido, apenas loga e considera texto simples
		log.Printf("Não foi possível parsear JSON: %v. Tratando como texto bruto.", err)
		p.Message = string(d.Body)
	}

	// Aqui você faria validações/transformações necessárias
	if err := validatePayload(&p); err != nil {
		log.Printf("Payload inválido: %v", err)
		// Retry básico: republicar com header x-retries incrementado
		if err := maybeRetry(ch, d); err != nil {
			log.Printf("Erro ao tentar retry: %v. Fazendo Nack sem requeue.", err)
			// decide o que fazer: nack sem requeue (descartar) para evitar loop infinito
			_ = d.Nack(false, false)
			return
		}
		// se re-publicado com sucesso, ack do original
		if err := d.Ack(false); err != nil {
			log.Printf("Erro ao ack do original após republish: %v", err)
		}
		return
	}

	// PROCESSAMENTO (aqui apenas printamos)
	log.Printf("Processando payload ID=%s message=%s", p.ID, p.Message)

	// Simule algum processamento que pode falhar
	// if processamentoFalhou {
	//     // aqui poderíamos chamar maybeRetry ou nack/requeue
	// }

	// Se tudo OK -> ACK
	if err := d.Ack(false); err != nil {
		log.Printf("Erro ao ack: %v", err)
	}
}

// validatePayload faz validações mínimas do payload
func validatePayload(p *Payload) error {
	// Exemplo: mensagem não pode ser vazia
	if p.Message == "" {
		return errors.New("campo message vazio")
	}
	return nil
}

// maybeRetry repubblica a mensagem incrementando o header x-retries se abaixo do limite
func maybeRetry(ch *amqp.Channel, d *amqp.Delivery) error {
	headers := amqp.Table{}
	if d.Headers != nil {
		headers = d.Headers
	}

	var retries int
	if v, ok := headers["x-retries"]; ok {
		switch t := v.(type) {
		case int:
			retries = t
		case int32:
			retries = int(t)
		case int64:
			retries = int(t)
		case string:
			if n, err := strconv.Atoi(t); err == nil {
				retries = n
			}
		default:
			// ignore unknown type
		}
	}

	if retries >= maxRetries {
		log.Printf("Já atingiu maxRetries (%d). Não fará retry.", maxRetries)
		return fmt.Errorf("max retries atingido")
	}

	newHeaders := amqp.Table{}
	for k, v := range headers {
		newHeaders[k] = v
	}
	newHeaders["x-retries"] = retries + 1

	// Republishes na mesma fila
	err := ch.Publish(
		"",        // exchange
		queueName, // routing key = queue
		false,     // mandatory
		false,     // immediate
		amqp.Publishing{
			Headers:         newHeaders,
			ContentType:     d.ContentType,
			ContentEncoding: d.ContentEncoding,
			Body:            d.Body,
			DeliveryMode:    amqp.Persistent,
		},
	)
	if err != nil {
		return fmt.Errorf("erro ao republisht: %w", err)
	}
	log.Printf("Mensagem republicada para retry (%d/%d)", retries+1, maxRetries)
	return nil
}
